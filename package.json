{
	"name": "girbind-devel",
	"version": "0.5.1",
	"description": "Generate Node.js bindings from GObject Introspection (GIR) files",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/girbind.git"
	},
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"homepage": "https://github.com/james-pre/girbind#readme",
	"bugs": {
		"url": "https://github.com/james-pre/girbind/issues"
	},
	"license": "LGPL-3.0-or-later",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"girbind": "dist/main.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"keywords": [
		"gir",
		"addon",
		"native"
	],
	"files": [
		"dist",
		"templates"
	],
	"workspaces": [
		"runtime"
	],
	"scripts": {
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "tsc --noEmit && tsc --noEmit -p runtime && eslint src runtime/src",
		"test": "node test/runtime.js && bash test/flatpak.sh && bash test/gio.sh",
		"build": "tsc && npm run build -w girbind",
		"prepublishOnly": "npm run build",
		"build:native": "npm run build:native -w girbind",
		"version": "npm pkg set \"peerDependencies.girbind=^$npm_package_version\" && npm version \"$npm_package_version\" --workspace girbind --no-git-tag-version --allow-same-version && git add package.json package-lock.json runtime/package.json"
	},
	"devDependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.0.0",
		"eslint": "^10.1.0",
		"globals": "^17.4.0",
		"prettier": "^3.2.5",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0"
	},
	"dependencies": {
		"cmake-js": "^8.0.0",
		"commander": "^15.0.0",
		"fast-xml-parser": "^5.9.3",
		"ioium": "^1.6.0",
		"node-addon-api": "^8.9.0"
	},
	"binary": {
		"napi_versions": [
			7
		]
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 120,
		"arrowParens": "avoid",
		"experimentalOperatorPosition": "start"
	},
	"peerDependencies": {
		"girbind": "^0.5.1"
	}
}
