{
	"name": "girbind",
	"version": "0.4.0",
	"description": "Runtime for Node.js bindings generated by girbind-devel from GObject Introspection",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/girbind.git",
		"directory": "runtime"
	},
	"funding": {
		"type": "individual",
		"url": "https://github.com/sponsors/james-pre"
	},
	"homepage": "https://github.com/james-pre/girbind#readme",
	"bugs": {
		"url": "https://github.com/james-pre/girbind/issues"
	},
	"license": "LGPL-3.0-or-later",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"keywords": [
		"gir",
		"gobject",
		"gtk",
		"native"
	],
	"files": [
		"dist",
		"include",
		"native",
		"CMakeLists.txt"
	],
	"binary": {
		"napi_versions": [
			10
		]
	},
	"scripts": {
		"build": "tsc",
		"build:native": "cmake-js compile --out build/cmake",
		"prepublishOnly": "npm run build"
	}
}
